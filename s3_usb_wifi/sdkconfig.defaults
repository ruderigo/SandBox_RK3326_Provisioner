# FireFly S3 USB Wi-Fi (Freenove ESP32-S3 WROOM CAM; any ESP32-S3 with native USB)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FREERTOS_HZ=1000

# The log on UART0 (the board's CH343 port); native USB is the network card
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# USB: CDC-NCM (the network card) and one CDC-ACM port (its control channel)
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_DESC_CDC_STRING="FireFly S3 control"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="FireFly"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="FireFly S3 USB Wi-Fi"
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=4
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=4

# lwIP is for the setup AP only: the handheld's side is a bridge
# CONFIG_LWIP_IPV6 is not set

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The same source makes the same image (CI checks the committed one)
CONFIG_APP_REPRODUCIBLE_BUILD=y
# CONFIG_APP_COMPILE_TIME_DATE is not set
