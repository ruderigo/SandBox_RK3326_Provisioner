# FireFly S3 USB Wi-Fi (Freenove ESP32-S3 WROOM CAM; any ESP32-S3 with native USB)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_FREERTOS_HZ=1000

# The log on UART0 (the board's CH343 port); native USB is the network card
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# USB: CDC-NCM only
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="FireFly"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="FireFly S3 USB Wi-Fi"
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=4
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=4

# Routing between USB and the joined Wi-Fi
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# CONFIG_LWIP_IPV4_NAPT_PORTMAP is not set
CONFIG_LWIP_L2_TO_L3_COPY=y

# No IPv6 at all: no router advertisements on USB
# CONFIG_LWIP_IPV6 is not set

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS is not set
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The same source makes the same image (CI checks the committed one)
CONFIG_APP_REPRODUCIBLE_BUILD=y
# CONFIG_APP_COMPILE_TIME_DATE is not set
